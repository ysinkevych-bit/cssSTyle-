body {
    margin: 0;
    padding: 0;
    min-height: 100vh;

    display: flex;
    justify-content: center;
    align-items: center;

    background: linear-gradient(135deg, #111827, #1e3a5f);
    font-family: Arial, Helvetica, sans-serif;
    color: #ffffff;
}

body > * {
    box-sizing: border-box;
}

h2 {
    margin: 0 0 30px;
    font-size: 32px;
    color: #ffffff;
    letter-spacing: 1px;
}

p {
    margin: 12px 0;
    font-size: 16px;
    color: #dbeafe;
}

p b {
    color: #60a5fa;
}

a {
    color: #60a5fa;
    text-decoration: none;
    transition: color 0.2s ease;
}

a:hover {
    color: #93c5fd;
    text-decoration: underline;
}

/* Карточка */
body {
    position: relative;
}

body::before {
    content: "";
    position: absolute;
    width: 500px;
    height: 500px;
    background: rgba(59, 130, 246, 0.15);
    border-radius: 50%;
    filter: blur(80px);
}

h2,
p {
    position: relative;
    z-index: 1;
}

/* Белая карточка вокруг контента */
body {
    padding: 40px;
}

body > h2,
body > p {
    width: 500px;
    margin-left: auto;
    margin-right: auto;
}

h2 {
    background: #172554;
    padding: 30px;
    border-radius: 16px 16px 0 0;
}

p {
    background: #ffffff;
    color: #1e293b;
    padding: 12px 30px;
    margin: 0 auto;
}

p:last-child {
    padding-bottom: 30px;
    border-radius: 0 0 16px 16px;
}
